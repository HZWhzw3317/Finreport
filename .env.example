
# ===== 应用 =====
APP_NAME=finreport
DEBUG=true

# ===== MySQL (Tortoise 连接串, asyncmy 驱动) =====
DATABASE_URL=mysql://finreport:finreport@127.0.0.1:3306/finreport

# ===== 存储 =====
PDF_DIR=./data/pdfs

# ===== 大模型 (OpenAI 兼容接口) =====
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-flash
LLM_MAX_PAGES_PER_STATEMENT=6
LLM_RENDER_DPI=200
LLM_TEMPERATURE=0
LLM_CONFIDENCE_THRESHOLD=0.8

# ===== 规则抽取阈值 =====
RULE_MIN_ITEMS=8
CORE_MISSING_RATIO=0.3
MERGE_STRATEGY=auto

# ===== 采集 =====
DOWNLOAD_DELAY=1.5
MAX_RETRY=3

# ===== 接口文档静态资源（默认国内可访问 CDN，可按需替换） =====
SWAGGER_JS_URL=https://cdn.bootcdn.net/ajax/libs/swagger-ui/5.17.14/swagger-ui-bundle.min.js
SWAGGER_CSS_URL=https://cdn.bootcdn.net/ajax/libs/swagger-ui/5.17.14/swagger-ui.min.css
REDOC_JS_URL=https://unpkg.com/redoc@2/bundles/redoc.standalone.js
